root = true

[*]
tab_width = 2
indent_stype = space
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true


[*.{cs, csproj, csx, sln}]
tab_width = 4

[*.cs]
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = inside_namespace

# 80 is what the code was already written to: measured across src and test, the
# 95th percentile line is exactly 80 characters. It records the existing target
# rather than imposing a new one. Nothing in the build enforces this — Roslyn
# ignores max_line_length and only the IDE and reformatter read it — so the
# ~1600 longer lines already in the tree are not errors, and two thirds of them
# are XML doc prose or embedded source strings that should not be wrapped
# anyway. Wrap when you touch a line, not in a sweep of its own.
max_line_length = 80

[src/Waystone.Monads.Analyzers*/**.cs]

# Microsoft.CodeAnalysis.Analyzers ships these off by default. They are the
# descriptor conventions this repository follows, so the build enforces them
# rather than leaving them to review. RS1007 stays off deliberately: descriptor
# strings are raw literals, not LocalizableResourceString, so that they read in
# Rules.cs.
dotnet_diagnostic.RS1015.severity = warning
dotnet_diagnostic.RS1020.severity = warning
dotnet_diagnostic.RS1028.severity = warning

[src/Waystone.Monads.Schemas/Schema.cs]

# RS0026 forbids several overloads of one name from carrying optional
# parameters, because a later addition can silently rebind a call site. Every
# field constructor in this file needs one: CallerArgumentExpression is what
# derives the violation path, and the compiler only fills it in on an optional
# parameter. The hazard cannot arise here, because the overloads are separated
# by mutually exclusive generic constraints - an Option<TIn>, a reference TIn
# and a nullable value TIn are three shapes no single argument satisfies at
# once, so an ambiguity is a CS0121 at the call site rather than a silent
# rebind. Scoped to this file so a genuine overload hazard elsewhere in the
# package still reports.
dotnet_diagnostic.RS0026.severity = none

[src/Waystone.Monads.Schemas/SchemaOfTInTOut.cs]

# The same exemption, for the same reason, on Check and CheckAsync.
# CallerArgumentExpression captures the predicate's source text so {Predicate}
# can render it, and the compiler fills it only on an optional parameter. The
# silent-rebind hazard cannot arise: each name has exactly two overloads, they
# are separated by the type of the second parameter - a ViolationCode struct
# against an ErrorCode reference - and no argument is both, so a would-be
# ambiguity is a compile error at the call site rather than a quiet move to the
# other overload. Scoped to this file for the same reason as above.
dotnet_diagnostic.RS0026.severity = none
