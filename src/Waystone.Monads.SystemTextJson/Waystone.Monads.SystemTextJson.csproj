<Project Sdk="Microsoft.NET.Sdk">

    <!--
    net8.0 is here only so the trimming attributes on the converter factories
    compile. DynamicDependencyAttribute and DynamicallyAccessedMembersAttribute
    do not exist on netstandard2.0 and PolySharp does not polyfill them, so the
    factories carry them behind an #if and the netstandard2.0 asset ships
    without them - a trimmer never sees that asset anyway. The public surface is
    identical across both targets.
    -->
    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
        <LangVersion>latestMajor</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <Title>Waystone.Monads.SystemTextJson</Title>
        <Description>
            An interop package for using System.Text.Json with Waystone.Monads, providing converters that round-trip Option and Result values.
        </Description>
        <PackageTags>result pattern option monad aspnetcore rust error handling framework json serialization system.text.json</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <AdditionalFiles Include="PublicAPI.Shipped.txt"/>
        <AdditionalFiles Include="PublicAPI.Unshipped.txt"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="System.Text.Json"/>
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="PolySharp">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Waystone.Monads\Waystone.Monads.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>
</Project>
