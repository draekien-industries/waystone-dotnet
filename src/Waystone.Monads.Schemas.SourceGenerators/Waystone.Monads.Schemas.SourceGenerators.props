<Project>
    <ItemGroup Label="Load the shipped schema source generators into the importing project's build">
        <ProjectReference Include="$(MSBuildThisFileDirectory)Waystone.Monads.Schemas.SourceGenerators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
        <ProjectReference Include="$(MSBuildThisFileDirectory)..\Waystone.Monads.Schemas.SourceGenerators.CodeFixes\Waystone.Monads.Schemas.SourceGenerators.CodeFixes.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>
</Project>
