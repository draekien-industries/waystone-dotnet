<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <ProjectReference Include="..\..\..\src\Waystone.Monads\Waystone.Monads.csproj"/>
    </ItemGroup>

    <!--
        The analyzers are deliberately not imported. A documentation page shows
        Unwrap and Expect on purpose, and the WM1xxx rules exist to report
        exactly that, so importing them would fail this build on samples that
        are correct for their page. Rule coverage lives in
        sample/Waystone.Monads.Analyzers.Sample instead.
    -->

    <!--
        The source generator is a different matter. It ships inside the core
        package, so a reader with Waystone.Monads installed already has it, and
        the errors guide shows a generated catalog. Imported by hand only
        because this project takes the library by ProjectReference.
    -->
    <Import Project="..\..\..\src\Waystone.Monads.SourceGenerators\Waystone.Monads.SourceGenerators.props"/>

</Project>
