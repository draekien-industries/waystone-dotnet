<Project>

    <PropertyGroup>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <LangVersion>latestMajor</LangVersion>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <!--
        net10.0 alone, because the shop is an ASP.NET Core 10 application over EF Core
        10 and both ship net10.0 and nothing older.

        Singular, because TargetFrameworks makes a project multi-targeting even when it
        names one framework, and dotnet run then refuses until it is told which
        framework to use. Plain `dotnet run` is the command the README tells a reader to
        type.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <!--
        The sample is held to the analyzers it demonstrates. `strict` is the preset a
        reader copying this code should be running, so anything the rules dislike here
        fails the build rather than shipping as an example.

        The property is set before the import because the preset is added as an
        EditorConfigFiles item under a condition on it, and MSBuild evaluates in order.
    -->
    <PropertyGroup>
        <WaystoneMonadsRuleset>strict</WaystoneMonadsRuleset>
    </PropertyGroup>

    <Import Project="..\..\src\Waystone.Monads.Analyzers\Waystone.Monads.Analyzers.props"/>
    <Import Project="..\..\src\Waystone.Monads\build\Waystone.Monads.props"/>

</Project>
