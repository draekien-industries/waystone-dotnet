<Project Sdk="Microsoft.NET.Sdk.Web">

    <!--
        The only project here that references EF Core. Persistence stays behind the
        repository interfaces the contexts declare, so a context is testable without
        a database and cannot reach for a DbContext by accident.
    -->
    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite"/>
        <PackageReference Include="Serilog.AspNetCore"/>
        <PackageReference Include="Serilog.Extensions.Hosting"/>
        <PackageReference Include="Serilog.Settings.Configuration"/>
        <PackageReference Include="Serilog.Sinks.Console"/>
    </ItemGroup>

    <!--
        Top-level statements make Program internal, so WebApplicationFactory<Program>
        cannot see it from outside. The tests reach ShopDatabase.ConnectionName the same
        way, rather than repeating the configuration key as a literal.
    -->
    <ItemGroup>
        <InternalsVisibleTo Include="Vagrant.Host.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vagrant.SharedKernel\Vagrant.SharedKernel.csproj"/>
        <ProjectReference Include="..\Vagrant.Appraisal\Vagrant.Appraisal.csproj"/>
        <ProjectReference Include="..\Vagrant.Catalog\Vagrant.Catalog.csproj"/>
        <ProjectReference Include="..\..\..\src\Waystone.Monads.Extensions.Hosting\Waystone.Monads.Extensions.Hosting.csproj"/>
        <ProjectReference Include="..\..\..\src\Waystone.Monads.Schemas\Waystone.Monads.Schemas.csproj"/>
        <ProjectReference Include="..\..\..\src\Waystone.Monads.SystemTextJson\Waystone.Monads.SystemTextJson.csproj"/>
        <ProjectReference Include="..\..\..\src\Serilog.Enrichers.Waystone.WideLogEvents.AspNetCore\Serilog.Enrichers.Waystone.WideLogEvents.AspNetCore.csproj"/>
    </ItemGroup>

    <!--
        Imported by hand because this project takes the library by ProjectReference. A
        consumer with a PackageReference gets the generator from the nupkg and writes
        nothing.
    -->
    <Import Project="..\..\..\src\Waystone.Monads.Schemas.SourceGenerators\Waystone.Monads.Schemas.SourceGenerators.props"/>

</Project>
