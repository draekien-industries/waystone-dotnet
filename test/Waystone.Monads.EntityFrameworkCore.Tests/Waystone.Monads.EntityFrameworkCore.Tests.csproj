<Project Sdk="Microsoft.NET.Sdk">

    <!--
    Drops net472 and net481 from the matrix in test/Directory.Build.props, which
    every other test project inherits. The subject depends on EF Core, which ships
    net8.0+ assets only, so neither .NET Framework target can restore against it
    (NU1201). net9.0 stays: it resolves the net8.0 asset, so the tests cover the
    runtime a net9.0 consumer would actually get.
    -->
    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0;</TargetFrameworks>
        <RootNamespace>Waystone.Monads.EntityFrameworkCore</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="xunit.runner.visualstudio"/>
        <PackageReference Include="Shouldly"/>
        <PackageReference Include="coverlet.collector"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Waystone.Monads.EntityFrameworkCore\Waystone.Monads.EntityFrameworkCore.csproj"/>
        <ProjectReference Include="..\..\src\Waystone.Monads.Shouldly\Waystone.Monads.Shouldly.csproj"/>
    </ItemGroup>

</Project>
